[Unit]
Description=Media Intelligence database-controlled schedule tick
After=network-online.target media-intelligence.service
[Service]
Type=oneshot
User=media-intelligence
Group=media-intelligence
WorkingDirectory=/opt/media-intelligence/backend
EnvironmentFile=/etc/media-intelligence.env
ExecStart=/usr/bin/node dist/vps-scheduler.js
TimeoutStartSec=900
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/media-intelligence
